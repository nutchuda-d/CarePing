    {
        "id": "cp_tab_main",
        "type": "tab",
        "label": "CarePing",
        "disabled": false,
        "info": "Bedside buttons \u2192 CarePing web console, and caregiver acknowledgements back to the buttons.\n\nButton topics:\n- careping/<CODE>/request  {\"type\":\"help|pain|water|toilet\"}\n- careping/<CODE>/status   {\"status\":\"online|offline\"}\n- careping/<CODE>/ack      (sent to the button) {\"state\":\"otw|done|waiting\",\"by\":\"Nurse Noon\"}",
        "env": []
    },
    {
        "id": "cp_comment_in",
        "type": "comment",
