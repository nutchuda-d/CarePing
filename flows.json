    {
        "id": "cp_ack_build",
        "type": "function",
        "z": "cp_tab_main",
        "name": "Build ack for button",
        "func": "// The web console says a caregiver accepted / finished / reassigned a request.\n// Output 1 \u2192 MQTT to the button (careping/<CODE>/ack)   Output 2 \u2192 HTTP reply to the web server\nconst body = msg.payload || {};\nconst device = String(body.device || '').toUpperCase();\nconst state = String(body.state || '');\nif (!/^CP-[0-9A-Z]{4}$/.test(device) || !['waiting', 'otw', 'done'].includes(state)) {\n    msg.statusCode = 400;\n    msg.payload = { error: 'Need device (CP-XXXX) and state (waiting | otw | done)' };\n    return [null, msg];\n}\nconst ack = {\n    topic: `careping/${device}/ack`,\n    payload: JSON.stringify({ state, type: body.type || null, by: body.by || null, at: new Date().toISOString() }),\n    qos: 1,\n    retain: false\n};\nnode.status({ fill: state === 'done' ? 'green' : 'blue', shape: 'dot', text: `${device}: ${state}` });\nmsg.statusCode = 200;\nmsg.payload = { status: 'sent' };\nreturn [ack, msg];\n",
        "outputs": 2,
        "timeout": 0,
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [],
        "x": 420,
        "y": 320,
        "wires": [
            [
                "cp_mqtt_out",
                "cp_debug_ack"
            ],
            [
                "cp_http_resp"
            ]
        ]
    },
