            [
                "cp_parse"
            ]
        ]
    },
    {
        "id": "cp_parse",
        "type": "function",
        "z": "cp_tab_main",
        "name": "Parse CarePing message",
        "func": "// Turns a raw button message into what the web console expects.\n// Topics: careping/<CODE>/request  payload {\"type\":\"water\"}  (or just: water)\n//         careping/<CODE>/status   payload {\"status\":\"online\"} (or: online / offline)\nconst parts = String(msg.topic || '').split('/');\nif (parts.length !== 3 || parts[0] !== 'careping') return null;\nconst device = parts[1].toUpperCase();\nconst kind = parts[2];\nif (!/^CP-[0-9A-Z]{4}$/.test(device)) return null;\n\nlet data = msg.payload;\nif (Buffer.isBuffer(data)) data = data.toString();\nif (typeof data === 'string') {\n    try { data = JSON.parse(data); } catch (e) { data = { value: data.trim() }; }\n}\nif (!data || typeof data !== 'object') data = { value: String(data) };\n\nlet out;\nif (kind === 'request') {\n    const type = String(data.type || data.value || '').toLowerCase();\n    if (!['help', 'pain', 'water', 'toilet'].includes(type)) {\n        node.warn(`Ignored unknown request type \"${type}\" from ${device}`);\n        return null;\n    }\n    out = { device, type };\n    node.status({ fill: type === 'help' ? 'red' : 'blue', shape: 'dot', text: `${device}: ${type}` });\n} else if (kind === 'status') {\n    const status = String(data.status || data.value || 'online').toLowerCase() === 'offline' ? 'offline' : 'online';\n    out = { device, status };\n} else {\n    return null;   // e.g. our own careping/<code>/ack messages\n}\n\nmsg.headers = { 'Content-Type': 'application/json' };\nmsg.payload = { topic: msg.topic, payload: out, timestamp: new Date().toISOString() };\nreturn msg;\n",
        "outputs": 1,
        "timeout": 0,
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [],
        "x": 400,
        "y": 120,
        "wires": [
            [
                "cp_to_web",
                "cp_debug_in"
            ]
        ]
    },
